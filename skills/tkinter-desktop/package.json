{
  "name": "dsh-tkinter-desktop",
  "version": "2.0.0",
  "description": "Tkinter/ttk native desktop application development skill as a distributable DeepSeek Harness (dsh) Cordis Bundle plugin. Registers the tkinter-desktop Agent Skill (self-contained: SKILL.md plus references/, pygubu/, ctypes/, pywin32/, tcl-tk/, templates/) as an embedded skill provider on ctx.skills.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "cordis.patch.yml",
    "SKILL.md",
    "locale/*.json",
    "icon.svg",
    "references",
    "scripts",
    "docs",
    "templates",
    "examples",
    "pygubu",
    "ctypes",
    "pywin32",
    "tcl-tk",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "SECURITY.md",
    "contributing.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "cordis-bundle",
    "agent-skill",
    "skill-provider",
    "tkinter",
    "ttk",
    "pygubu",
    "desktop",
    "gui",
    "pyinstaller"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-skill": "^0.2.2-rc.1",
    "@deepseek-ai/cordis": "^4.1.0"
  }
}
