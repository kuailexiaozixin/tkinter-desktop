# -*- coding: utf-8 -*-
"""示例页面：工具条 + Treeview + 表单弹窗触发。"""
import tkinter as tk
from tkinter import ttk


class ItemView(ttk.Frame):
    def __init__(self, master):
        super().__init__(master, padding=8)
        self.on_add = None      # Controller 注入
        self.on_delete = None
        self.on_search = None

        self.columnconfigure(0, weight=1)
        self.rowconfigure(1, weight=1)

        # 工具条
        bar = ttk.Frame(self)
        bar.grid(row=0, column=0, sticky="ew", pady=(0, 6))
        self.kw_var = tk.StringVar()
        ttk.Entry(bar, textvariable=self.kw_var, width=24).pack(side="left")
        ttk.Button(bar, text="搜索", command=lambda: self._cb(self.on_search)).pack(
            side="left", padx=6
        )
        ttk.Button(bar, text="新增", style="Accent.TButton",
                   command=lambda: self._cb(self.on_add)).pack(side="left")
        ttk.Button(bar, text="删除", style="Danger.TButton",
                   command=lambda: self._cb(self.on_delete)).pack(side="left", padx=6)

        # 表格
        cols = ("name", "remark", "created")
        self.tree = ttk.Treeview(self, columns=cols, show="headings", selectmode="browse")
        for cid, text, w in (("name", "名称", 200), ("remark", "备注", 320), ("created", "创建日期", 120)):
            self.tree.heading(cid, text=text)
            self.tree.column(cid, width=w, anchor="w", stretch=(cid == "remark"))
        vsb = ttk.Scrollbar(self, orient="vertical", command=self.tree.yview)
        self.tree.configure(yscrollcommand=vsb.set)
        self.tree.grid(row=1, column=0, sticky="nsew")
        vsb.grid(row=1, column=1, sticky="ns")

    def _cb(self, fn):
        if fn:
            fn()

    def refresh(self, rows) -> None:
        self.tree.delete(*self.tree.get_children())
        for i, r in enumerate(rows):
            tag = "odd" if i % 2 else "even"
            self.tree.insert("", "end", iid=str(r["id"]),
                             values=(r["name"], r["remark"], r["created"]), tags=(tag,))
        self.tree.tag_configure("odd", background="#f5f7fa")

    def selected_id(self):
        sel = self.tree.selection()
        return int(sel[0]) if sel else None
